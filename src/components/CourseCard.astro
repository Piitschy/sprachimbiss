---
export interface Props {
	scheduleLabel: string;
	time?: string;
	title: string;
	description: string;
	scheduleLabelDe: string;
	titleDe: string;
	descriptionDe: string;
	slug: string;
}

const { scheduleLabel, time, title, description, scheduleLabelDe, titleDe, descriptionDe, slug } = Astro.props;
---

<a class="course-card" href={`/kurse/${slug}/`}>
	<div class="course-schedule">
		<span class="schedule-label" data-uk={scheduleLabel} data-de={scheduleLabelDe}>{scheduleLabel}</span>
		{time && <span class="schedule-time">{time}</span>}
	</div>
	<div class="course-details">
		<h3 data-uk={title} data-de={titleDe}>{title}</h3>
		<p data-uk={description} data-de={descriptionDe}>{description}</p>
		<span class="course-link" data-uk="Дізнатися більше" data-de="Mehr erfahren">Дізнатися більше <span aria-hidden="true">↗</span></span>
	</div>
</a>

<style>
	.course-card {
		display: grid;
		grid-template-columns: minmax(150px, 0.7fr) 1.3fr;
		gap: 2rem;
		padding: 2rem;
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid rgba(255, 255, 255, 0.9);
		border-radius: 15px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		text-decoration: none;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.course-card:hover, .course-card:focus-visible {
		transform: translateY(-4px);
		box-shadow: 0 16px 35px rgba(70, 76, 130, 0.16);
	}

	.course-card:focus-visible {
		outline: 3px solid rgba(102, 126, 234, 0.45);
		outline-offset: 4px;
	}

	.course-schedule {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		align-self: start;
		color: #667eea;
	}

	.schedule-label {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.45;
	}

	.schedule-time {
		font-family: 'Playfair Display', serif;
		font-size: 1.35rem;
		font-weight: 700;
		color: #2c3e50;
	}

	.course-details h3 {
		font-family: 'Playfair Display', serif;
		font-size: 1.5rem;
		line-height: 1.25;
		color: #2c3e50;
		margin-bottom: 0.85rem;
	}

	.course-details p {
		color: #4a5568;
		line-height: 1.7;
	}

	.course-link {
		display: inline-flex;
		gap: 0.45rem;
		margin-top: 1.25rem;
		color: #667eea;
		font-size: 0.9rem;
		font-weight: 500;
	}

	@media (max-width: 600px) {
		.course-card {
			grid-template-columns: 1fr;
			gap: 1.1rem;
			padding: 1.5rem;
		}

		.course-details h3 {
			font-size: 1.35rem;
		}
	}
</style>
