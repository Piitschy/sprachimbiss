---
import Layout from '../layouts/Layout.astro';
import CourseCard from '../components/CourseCard.astro';
import { courses } from '../data/courses';
---

<Layout lang="uk" title="Курси німецької мови | Sprachimbiss" description="Розмовні курси німецької мови для дорослих та дітей із Vita Sarvirova.">
	<main class="courses-page">
		<div class="courses-container">
			<header class="page-intro">
				<p class="eyebrow">Sprachimbiss · Deutsch mit Genuss</p>
				<h1><span class="title-main" data-uk="Курси німецької мови" data-de="Deutschkurse">Курси німецької мови</span><span data-uk="для дорослих та дітей" data-de="für Erwachsene und Kinder">для дорослих та дітей</span></h1>
				<p class="intro-message" data-uk="Запускаємо нові формати щомісяця – знайди свій!" data-de="Wir starten jeden Monat neue Formate – finde deinen Kurs!">Запускаємо нові формати щомісяця – знайди свій!</p>
				<p class="online-note" data-uk="Усі курси проходять онлайн." data-de="Alle Kurse finden online statt.">Усі курси проходять онлайн.</p>
			</header>

			<section class="schedule-section" aria-labelledby="schedule-heading">
				<div class="section-heading">
					<p class="eyebrow" data-uk="Разом говоримо впевненіше" data-de="Gemeinsam sicherer sprechen">Разом говоримо впевненіше</p>
					<h2 id="schedule-heading" data-uk="Розклад групових занять на вересень" data-de="Stundenplan der Gruppenkurse im September">Розклад групових занять на вересень</h2>
				</div>
				<div class="course-grid">
					{courses.map((course) => <CourseCard {...course} />)}
				</div>
			</section>

			<section class="contact-panel" aria-labelledby="contact-heading">
				<div class="contact-copy">
					<p class="eyebrow" data-uk="Перший крок" data-de="Der erste Schritt">Перший крок</p>
					<h2 id="contact-heading" data-uk="Забронюйте собі місце на обраному гуртку прямо зараз!" data-de="Sichere dir jetzt einen Platz in deinem Wunschkurs!">Забронюйте собі місце на обраному гуртку прямо зараз!</h2>
					<p data-uk="Напишіть мені назву гуртка в особисті повідомлення." data-de="Schreib mir den Namen des Kurses als persönliche Nachricht.">Напишіть мені назву гуртка в особисті повідомлення.</p>
					<p data-uk="З жовтня запускатимемо й інші формати та заняття – зв'яжіться зі мною, щоб знайти ідеальну пропозицію саме для Вас🇩🇪" data-de="Ab Oktober starten weitere Formate und Kurse. Schreib mir, damit wir das ideale Angebot für dich finden 🇩🇪">З жовтня запускатимемо й інші формати та заняття – зв'яжіться зі мною, щоб знайти ідеальну пропозицію саме для Вас🇩🇪</p>
					<a class="primary-link" href="https://t.me/vitasilver"><span data-uk="Написати в Telegram" data-de="Auf Telegram schreiben">Написати в Telegram</span> <span aria-hidden="true">↗</span></a>
				</div>
				<div class="contact-details">
					<p class="contact-prompt" data-uk="Напишіть мені повідомлення – підберемо ідеальний курс для вас! 💜" data-de="Schreib mir eine Nachricht – wir finden den idealen Kurs für dich! 💜">Напишіть мені повідомлення – підберемо ідеальний курс для вас! 💜</p>
					<ul>
						<li><span>Telegram</span><a href="https://t.me/vitasilver">@vitasilver</a></li>
						<li><span>E-Mail</span><a href="mailto:vita@sprachimbiss.de">vita@sprachimbiss.de</a></li>
						<li><span>Website</span><a href="https://sprachimbiss.de/">sprachimbiss.de</a></li>
						<li><span>Тел. (WhatsApp)</span><a href="tel:+4915203977315">+4915203977315</a></li>
					</ul>
				</div>
			</section>
		</div>
	</main>
</Layout>

<style>
	.courses-page {
		padding: 8rem 2rem 4rem;
	}

	.courses-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.page-intro {
		max-width: 780px;
		margin: 0 auto 5rem;
		text-align: center;
	}

	.eyebrow {
		margin-bottom: 0.9rem;
		color: #667eea;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1, h2, h3 {
		font-family: 'Playfair Display', serif;
	}

	h1 {
		font-size: clamp(2.6rem, 6vw, 4.8rem);
		line-height: 1.08;
		color: #2c3e50;
	}

	h1 span {
		display: block;
		margin-top: 0.55rem;
		font-size: 0.48em;
		font-weight: 400;
		color: #667eea;
	}

	h1 .title-main {
		margin-top: 0;
		font-size: 1em;
		font-weight: 700;
		color: #2c3e50;
	}

	.intro-message {
		margin-top: 1.7rem;
		color: #4a5568;
		font-size: 1.2rem;
		font-weight: 300;
	}

	.online-note {
		margin-top: 1rem;
		color: #667eea;
		font-size: 0.95rem;
		font-weight: 500;
	}

	.section-heading {
		margin-bottom: 1.8rem;
	}

	h2 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.2;
		color: #2c3e50;
	}

	.course-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.contact-panel {
		margin-top: 5rem;
		padding: 2.5rem;
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid rgba(255, 255, 255, 0.9);
		border-radius: 15px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
	}

	.contact-panel {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 4rem;
		padding: 3rem;
		background: linear-gradient(135deg, rgba(102, 126, 234, 0.96), rgba(118, 75, 162, 0.96));
	}

	.contact-panel .eyebrow, .contact-panel h2, .contact-panel p, .contact-panel a, .contact-panel span {
		color: white;
	}

	.contact-panel h2 {
		font-size: clamp(2rem, 4vw, 3rem);
	}

	.contact-copy > p:not(.eyebrow), .contact-prompt {
		margin-top: 1.2rem;
		font-size: 1.05rem;
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin-top: 2rem;
		padding-bottom: 0.3rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.7);
		font-weight: 500;
		text-decoration: none;
	}

	.primary-link:hover, .contact-details a:hover {
		opacity: 0.8;
	}

	.contact-details ul {
		margin-top: 1.8rem;
		padding: 0;
		list-style: none;
	}

	.contact-details li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.25);
	}

	.contact-details li span {
		font-size: 0.9rem;
		opacity: 0.8;
	}

	.contact-details a {
		text-align: right;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (max-width: 768px) {
		.courses-page {
			padding: 8rem 1rem 2rem;
		}

		.page-intro {
			margin-bottom: 3.5rem;
		}

		.course-grid, .contact-panel {
			grid-template-columns: 1fr;
		}

		.contact-panel {
			margin-top: 3.5rem;
			padding: 1.75rem;
		}

		.contact-panel {
			gap: 2rem;
		}
	}

	@media (max-width: 420px) {
		.contact-details li {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}

		.contact-details a {
			text-align: left;
		}
	}
</style>
